AGENT_DATA_DIR=./data
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_PROVIDER=ollama
DEFAULT_MODEL_ID=llama3.2
# LLAMACPP_BASE_URL=http://127.0.0.1:8080
# ALLOW_MOCK_FALLBACK=true
API_HOST=127.0.0.1
API_PORT=8765

# ── Provedores (expansão multi-provedor) ────────────────────────────────────
# Arquivo declarativo com os provedores nomeados (YAML ou JSON).
# Veja o exemplo versionado em `providers.example.yaml`.
# PROVIDERS_CONFIG_PATH=./providers.yaml

# Política comum dos provedores HTTP:
# PROVIDER_TIMEOUT_SEC=120
# PROVIDER_MAX_RETRIES=1
# PROVIDER_ALLOW_PRIVATE_HOSTS=true
# PROVIDER_VERIFY_TLS=true

# Credenciais ficam no ambiente, nunca no arquivo versionado:
# OPENROUTER_API_KEY=...
# ANTHROPIC_API_KEY=...
# GEMINI_API_KEY=...
# OPENAI_API_KEY=...
